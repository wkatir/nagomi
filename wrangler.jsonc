{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagomi",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "ORDER_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EXPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagomi",
      "database_id": "34af1df9-4e56-40ac-9aa9-b7cd6d21fd86",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nagomi-media" }]
}
