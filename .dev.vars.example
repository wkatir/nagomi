# Copy to .dev.vars for local development (never commit .dev.vars). In production set each
# one with `wrangler secret put <NAME>`.

# Signs and encrypts sessions; at least 32 random characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=

# The site's public origin; sign-in, canonical URLs and the sitemap use it. https outside
# localhost, e.g. http://localhost:4600 locally.
BETTER_AUTH_URL=

# Optional Google sign-in for existing admins. Set both or neither; with them set, password
# sign-in is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional card payments with Wompi El Salvador (https://docs.wompi.sv). In the Wompi panel the
# business's "App ID" is the client id and its "API Secret" the client secret; the same secret
# signs the webhooks. Set both or neither; without them the card method shows as unavailable.
# A business in development mode in the panel approves every test card except CVV 111.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
